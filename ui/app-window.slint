import { MaterialTheme } from "material-theme.slint";
import { I18n } from "i18n.slint";
import { ScrollView } from "std-widgets.slint";
import "./MaterialSymbolsRounded-VariableFont_FILL,GRAD,opsz,wght.ttf";

import {
    MaterialCard,
    MaterialFilledButton,
    MaterialTonalButton,
    MaterialOutlinedButton,
    MaterialNavigationItem,
    MaterialChoiceCard,
    MaterialSelect,
    MaterialPortField,
    PortOption,
    SectionTitle,
    FieldLabel,
    MaterialCheckbox,
    MaterialTextField,
    MaterialTextArea,
    MaterialReceiveView
} from "material-widgets.slint";


export component MainWindow inherits Window {
    title: "CitrusPort";

    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 600px;

    background: MaterialTheme.background;
    animate background { duration: 150ms; easing: ease-out; }


    // ========================================================================
    // State
    // ========================================================================

    in-out property <int> active_tab: 0;
    in-out property <bool> is_connected: false;
    in-out property <bool> is_connecting: false;
    in-out property <string> lang: "zh";
    in-out property <string> theme_id: "citrus-dark";

    in property <[PortOption]> available_ports: [];
    in-out property <string> current_port: "";
    in-out property <string> current_baud_rate: "115200";
    in-out property <string> current_encoding: "UTF-8";
    in-out property <string> current_data_bits: "8";
    in-out property <string> current_parity: "None";
    in-out property <string> current_stop_bits: "1";
    in-out property <string> current_flow_control: "None";

    in-out property <string> rx_content: I18n.welcome;
    in-out property <string> tx_content: "";
    in-out property <int> rx_byte_count: 0;
    in-out property <int> tx_byte_count: 0;

    in-out property <bool> cts_enabled: false;
    in-out property <bool> rts_enabled: false;
    in-out property <bool> break_enabled: false;

    in-out property <bool> hex_display: false;
    in-out property <bool> show_timestamp: true;
    in-out property <bool> auto_scroll: true;
    in-out property <bool> hex_send: false;

    in-out property <string> current_newline: "\\r\\n";

    init => {
        I18n.lang = root.lang;
        MaterialTheme.theme-id = root.theme_id;
    }

    changed lang => {
        I18n.lang = root.lang;
    }

    changed theme_id => {
        MaterialTheme.theme-id = root.theme_id;
    }


    // ========================================================================
    // Callbacks
    // ========================================================================

    callback toggle_port_clicked();
    callback send_clicked();
    callback clear_rx_clicked();
    callback save_rx_clicked();
    callback set_rts_clicked(bool);
    callback set_break_clicked(bool);
    callback language_changed(string);
    callback theme_changed(string);


    // ========================================================================
    // Main Layout
    // ========================================================================

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;


        // ====================================================================
        // Navigation Rail
        // ====================================================================

        Rectangle {
            width: 80px;

            background: MaterialTheme.surface_container;
            border-radius: 20px;
            animate background { duration: 150ms; easing: ease-out; }


            VerticalLayout {
                padding-top: 20px;
                padding-bottom: 20px;
                spacing: 8px;


                // ============================================================
                // Logo
                // ============================================================

                Rectangle {
                    width: 80px;
                    height: 72px;


                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;

                        width: 48px;
                        height: 48px;

                        border-radius: 16px;
                        background: MaterialTheme.primary_container;
                        animate background { duration: 150ms; easing: ease-out; }


                        Text {
                            width: parent.width;
                            height: parent.height;

                            text: "CP";

                            color: MaterialTheme.on_primary_container;
                            font-size: 17px;
                            font-weight: 800;

                            horizontal-alignment: center;
                            vertical-alignment: center;
                            animate color { duration: 150ms; easing: ease-out; }
                        }
                    }
                }


                // ============================================================
                // Navigation
                // ============================================================

                VerticalLayout {
                    width: 80px;
                    spacing: 4px;


                    MaterialNavigationItem {
                        width: 80px;
                        height: 64px;

                        icon: "usb";
                        label: I18n.nav_serial;

                        selected: root.active_tab == 0;

                        clicked => {
                            root.active_tab = 0;
                        }
                    }


                    MaterialNavigationItem {
                        width: 80px;
                        height: 64px;

                        icon: "monitoring";
                        label: I18n.nav_waveform;

                        selected: root.active_tab == 1;

                        clicked => {
                            root.active_tab = 1;
                        }
                    }


                    MaterialNavigationItem {
                        width: 80px;
                        height: 64px;

                        icon: "swap_horiz";
                        label: I18n.nav_protocol;

                        selected: root.active_tab == 2;

                        clicked => {
                            root.active_tab = 2;
                        }
                    }
                }


                // ============================================================
                // Bottom Spacer + Settings
                // ============================================================

                Rectangle {
                    vertical-stretch: 1;
                }


                MaterialNavigationItem {
                    width: 80px;
                    height: 64px;

                    icon: "settings";
                    label: I18n.nav_settings;

                    selected: root.active_tab == 3;

                    clicked => {
                        root.active_tab = 3;
                    }
                }
            }
        }


        // ====================================================================
        // Main Area
        // ====================================================================

        if root.active_tab == 0 : VerticalLayout {
            horizontal-stretch: 1;
            spacing: 16px;


            // =================================================================
            // Top App Bar
            // =================================================================

            Rectangle {
                height: 56px;
                background: Colors.transparent;


                HorizontalLayout {
                    spacing: 12px;


                    // ---------------------------------------------------------
                    // Page Title
                    // ---------------------------------------------------------

                    VerticalLayout {
                        spacing: 0px;


                        Text {
                            text: "CitrusPort";

                            height: 28px;

                            color: MaterialTheme.text_primary;
                            font-size: 24px;
                            font-weight: 600;

                            vertical-alignment: center;
                        }


                        Text {
                            text: root.is_connecting
                                ? I18n.status_connecting
                                : root.is_connected
                                    ? I18n.status_connected
                                    : I18n.status_disconnected;

                            height: 20px;

                            color: root.is_connecting
                                ? MaterialTheme.primary
                                : root.is_connected
                                    ? MaterialTheme.success
                                    : MaterialTheme.text_secondary;

                            font-size: 12px;

                            vertical-alignment: center;
                            animate color { duration: 150ms; easing: ease-out; }
                        }
                    }


                    // ---------------------------------------------------------
                    // Spacer
                    // ---------------------------------------------------------

                    Rectangle {
                        horizontal-stretch: 1;
                    }


                    // ---------------------------------------------------------
                    // Connection Indicator
                    // ---------------------------------------------------------

                    VerticalLayout {
                        alignment: center;


                        Rectangle {
                            width: 10px;
                            height: 10px;

                            border-radius: 5px;

                            background: root.is_connecting
                                ? MaterialTheme.primary_container
                                : root.is_connected
                                    ? MaterialTheme.success
                                    : MaterialTheme.outline;
                            animate background { duration: 150ms; easing: ease-out; }
                        }
                    }


                    Text {
                        text: root.is_connecting
                            ? I18n.indicator_connecting
                            : root.is_connected
                                ? I18n.indicator_connected
                                : I18n.indicator_disconnected;

                        color: MaterialTheme.text_secondary;
                        font-size: 12px;

                        vertical-alignment: center;
                        animate color { duration: 150ms; easing: ease-out; }
                    }
                }
            }


            // =================================================================
            // Main Workspace
            // =================================================================

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 16px;


                // =============================================================
                // Serial Settings
                // =============================================================

                MaterialCard {
                    width: 260px;


                    VerticalLayout {
                        padding: 20px;
                        spacing: 0px;


                        // -----------------------------------------------------
                        // Title
                        // -----------------------------------------------------

                        SectionTitle {
                            text: I18n.serial_settings;
                            height: 28px;
                        }


                        // -----------------------------------------------------
                        // Scrollable Parameters
                        // -----------------------------------------------------

                        ScrollView {
                            vertical-stretch: 1;

                            vertical-scrollbar-policy: always-off;
                            horizontal-scrollbar-policy: always-off;


                            VerticalLayout {
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 16px;


                                // =================================================
                                // Baud Rate
                                // =================================================

                                VerticalLayout {
                                    spacing: 6px;

                                    FieldLabel {
                                         text: I18n.port ; 
                                   } 
                                    MaterialPortField {
                                        width: 100%;
                                        horizontal-stretch: 1;
                                        options: root.available_ports;
                                        value <=> root.current_port;
                                        placeholder: I18n.placeholder_port;
                                        enabled: !root.is_connected && !root.is_connecting;
                                        accepted => { root.toggle_port_clicked(); }
                                    }


                                    FieldLabel {
                                        text: I18n.baud_rate;
                                    }


                                    MaterialSelect {
                                        width: 100%;

                                        value <=> root.current_baud_rate;

                                        options: [
                                            "9600",
                                            "19200",
                                            "38400",
                                            "57600",
                                            "115200",
                                            "230400",
                                            "460800",
                                            "921600",
                                            "1000000",
                                            "1500000",
                                            "2000000",
                                            "3000000"
                                        ];

                                        placeholder: I18n.placeholder_baud;
                                    }
                                }


                                // =================================================
                                // Data Bits
                                // =================================================

                                VerticalLayout {
                                    spacing: 6px;


                                    FieldLabel {
                                        text: I18n.data_bits;
                                    }


                                    MaterialSelect {
                                        width: 100%;

                                        value <=> root.current_data_bits;

                                        options: [
                                            "8",
                                            "7",
                                            "6",
                                            "5"
                                        ];

                                        placeholder: I18n.placeholder_data_bits;
                                    }
                                }


                                // =================================================
                                // Parity
                                // =================================================

                                VerticalLayout {
                                    spacing: 6px;


                                    FieldLabel {
                                        text: I18n.parity;
                                    }


                                    MaterialSelect {
                                        width: 100%;

                                        value <=> root.current_parity;

                                        options: [
                                            "None",
                                            "Even",
                                            "Odd",
                                            "Mark",
                                            "Space"
                                        ];

                                        placeholder: I18n.placeholder_parity;
                                    }
                                }


                                // =================================================
                                // Stop Bits
                                // =================================================

                                VerticalLayout {
                                    spacing: 6px;


                                    FieldLabel {
                                        text: I18n.stop_bits;
                                    }


                                    MaterialSelect {
                                        width: 100%;

                                        value <=> root.current_stop_bits;

                                        options: [
                                            "1",
                                            "1.5",
                                            "2"
                                        ];

                                        placeholder: I18n.placeholder_stop_bits;
                                    }
                                }


                                // =================================================
                                // Flow Control
                                // =================================================

                                VerticalLayout {
                                    spacing: 6px;


                                    FieldLabel {
                                        text: I18n.flow_control;
                                    }


                                    MaterialSelect {
                                        width: 100%;

                                        value <=> root.current_flow_control;

                                        options: [
                                            "None",
                                            "Software (XON/XOFF)",
                                            "Hardware (RTS/CTS)"
                                        ];

                                        placeholder: I18n.placeholder_flow;
                                    }
                                }


                                // =================================================
                                // Flow Control Signals
                                // =================================================

                                VerticalLayout {
                                    spacing: 8px;


                                    FieldLabel {
                                        text: I18n.flow_signals;
                                    }


                                    HorizontalLayout {
                                        spacing: 8px;


                                        // CTS 是输入信号，由后端周期读取，仅作状态显示。
                                        MaterialCheckbox {
                                            text: I18n.cts;
                                            checked <=> root.cts_enabled;
                                            enabled: false;
                                        }


                                        MaterialCheckbox {
                                            text: I18n.rts;
                                            checked <=> root.rts_enabled;
                                            enabled: root.is_connected;
                                            toggled => {
                                                root.set_rts_clicked(root.rts_enabled);
                                            }
                                        }


                                        MaterialCheckbox {
                                            text: I18n.break_label;
                                            checked <=> root.break_enabled;
                                            enabled: root.is_connected;
                                            toggled => {
                                                root.set_break_clicked(root.break_enabled);
                                            }
                                        }
                                    }
                                }
                            }
                        }


                        // -----------------------------------------------------
                        // Divider
                        // -----------------------------------------------------

                        Rectangle {
                            width: 100%;
                            height: 1px;

                            background: MaterialTheme.outline_variant;
                        }


                        // -----------------------------------------------------
                        // Bottom Action
                        // -----------------------------------------------------

                        Rectangle {
                            width: 100%;
                            height: 68px;


                            MaterialFilledButton {
                                x: 0px;
                                y: 12px;

                                width: parent.width;
                                height: 48px;

                                text: root.is_connecting
                                    ? I18n.opening
                                    : root.is_connected
                                        ? I18n.close_port
                                        : I18n.open_port;

                                enabled: !root.is_connecting;

                                clicked => {
                                    root.toggle_port_clicked();
                                }
                            }
                        }
                    }
                }


                // =============================================================
                // Receive
                // =============================================================

                MaterialCard {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;


                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;


                        SectionTitle {
                            text: I18n.receive_data;
                        }


                        // -----------------------------------------------------
                        // Receive Toolbar
                        // -----------------------------------------------------

                        HorizontalLayout {
                            height: 32px;
                            spacing: 8px;


                            MaterialCheckbox {
                                text: I18n.hex_display;
                                checked <=> root.hex_display;
                            }


                            MaterialCheckbox {
                                text: I18n.timestamp;
                                checked <=> root.show_timestamp;
                            }


                            MaterialCheckbox {
                                text: I18n.auto_scroll;
                                checked <=> root.auto_scroll;
                            }


                            Rectangle {
                                width: 1px;
                                height: 18px;

                                y: (parent.height - self.height) / 2;

                                background: MaterialTheme.outline_variant;
                            }


                            FieldLabel {
                                text: I18n.encoding_label;
                                height: 32px;
                            }


                            MaterialSelect {
                                width: 100px;
                                height: 32px;

                                value <=> root.current_encoding;

                                options: [
                                    "UTF-8",
                                    "GBK",
                                    "ASCII"
                                ];

                                placeholder: I18n.placeholder_encoding;
                            }


                            Rectangle {
                                horizontal-stretch: 1;
                            }


                            Text {
                                text: I18n.rx_short + " " + root.rx_byte_count + " B / " + I18n.tx_short + " " + root.tx_byte_count + " B";

                                color: MaterialTheme.text_secondary;
                                font-size: 12px;

                                vertical-alignment: center;
                            }
                        }


                        // -----------------------------------------------------
                        // Receive Text Area
                        // -----------------------------------------------------

                        MaterialReceiveView {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;

                            text: root.rx_content;
                            auto_scroll: root.auto_scroll;
                        }
                    }
                }
            }


            // =================================================================
            // Bottom Workspace
            // =================================================================

            HorizontalLayout {
                height: 176px;
                spacing: 16px;


                // =============================================================
                // Operations
                // =============================================================

                MaterialCard {
                    width: 260px;


                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;


                        SectionTitle {
                            text: I18n.actions;
                        }


                        MaterialTonalButton {
                            width: 100%;

                            text: I18n.clear_log;

                            clicked => {
                                root.clear_rx_clicked();
                            }
                        }


                        MaterialOutlinedButton {
                            width: 100%;

                            text: I18n.save_log;

                            clicked => {
                                root.save_rx_clicked();
                            }
                        }
                    }
                }


                // =============================================================
                // Transmit
                // =============================================================

                MaterialCard {
                    horizontal-stretch: 1;


                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;


                        SectionTitle {
                            text: I18n.transmit;
                        }


                        // -----------------------------------------------------
                        // Send Toolbar
                        // -----------------------------------------------------

                        HorizontalLayout {
                            height: 32px;
                            spacing: 12px;


                            MaterialCheckbox {
                                text: I18n.hex_send;
                                checked <=> root.hex_send;
                            }


                            Rectangle {
                                width: 1px;
                                height: 18px;

                                y: (parent.height - self.height) / 2;

                                background: MaterialTheme.outline_variant;
                            }


                            Rectangle {
                                horizontal-stretch: 1;
                            }


                            Text {
                                text: I18n.line_ending;

                                color: MaterialTheme.text_secondary;
                                font-size: 12px;

                                vertical-alignment: center;
                            }


                            MaterialSelect {
                                width: 96px;
                                height: 40px;

                                value <=> root.current_newline;

                                options: [
                                    "\\r\\n",
                                    "\\n",
                                    "\\r",
                                    "NONE"
                                ];

                                placeholder: I18n.placeholder_newline;
                            }
                        }


                        // -----------------------------------------------------
                        // Send Input
                        // -----------------------------------------------------

                        HorizontalLayout {
                            height: 48px;
                            spacing: 12px;


                            MaterialTextField {
                                horizontal-stretch: 1;

                                text <=> root.tx_content;
                                placeholder: I18n.placeholder_send;

                                accepted => {
                                    root.send_clicked();
                                }
                            }


                            MaterialFilledButton {
                                width: 90px;
                                height: 48px;

                                text: I18n.send;
                                enabled: root.is_connected;

                                clicked => {
                                    root.send_clicked();
                                }
                            }
                        }
                    }
                }
            }
        }


        // ====================================================================
        // Waveform / Protocol
        // ====================================================================

        if root.active_tab == 1 || root.active_tab == 2 : MaterialCard {
            horizontal-stretch: 1;
            vertical-stretch: 1;


            VerticalLayout {
                padding: 32px;
                alignment: center;
                spacing: 8px;


                Text {
                    text: root.active_tab == 1
                        ? I18n.waveform_analysis
                        : I18n.protocol_analysis;

                    color: MaterialTheme.text_primary;
                    font-size: 22px;
                    font-weight: 600;

                    width: 100%;

                    horizontal-alignment: center;
                    animate color { duration: 150ms; easing: ease-out; }
                }


                Text {
                    text: I18n.feature_in_development;

                    color: MaterialTheme.text_secondary;
                    font-size: 14px;

                    width: 100%;

                    horizontal-alignment: center;
                    animate color { duration: 150ms; easing: ease-out; }
                }
            }
        }


        // ====================================================================
        // Settings
        // ====================================================================

        if root.active_tab == 3 : VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            spacing: 16px;


            // ----------------------------------------------------------------
            // Settings Header
            // ----------------------------------------------------------------

            Rectangle {
                height: 56px;
                background: Colors.transparent;

                VerticalLayout {
                    spacing: 0px;

                    Text {
                        text: I18n.settings_title;
                        height: 30px;
                        color: MaterialTheme.text_primary;
                        font-size: 24px;
                        font-weight: 600;
                        vertical-alignment: center;
                        animate color { duration: 150ms; easing: ease-out; }
                    }

                    Text {
                        text: I18n.settings_subtitle;
                        height: 20px;
                        color: MaterialTheme.text_secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        animate color { duration: 150ms; easing: ease-out; }
                    }
                }
            }


            // ----------------------------------------------------------------
            // Language
            // ----------------------------------------------------------------

            MaterialCard {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    SectionTitle {
                        text: I18n.language_title;
                        height: 28px;
                    }

                    Text {
                        text: I18n.language_hint;
                        color: MaterialTheme.text_secondary;
                        font-size: 13px;
                        wrap: word-wrap;
                        animate color { duration: 150ms; easing: ease-out; }
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        MaterialChoiceCard {
                            horizontal-stretch: 1;
                            title: I18n.language_zh;
                            subtitle: I18n.language_zh_desc;
                            selected: root.lang == "zh";
                            clicked => {
                                root.lang = "zh";
                                root.language_changed("zh");
                            }
                        }

                        MaterialChoiceCard {
                            horizontal-stretch: 1;
                            title: I18n.language_en;
                            subtitle: I18n.language_en_desc;
                            selected: root.lang == "en";
                            clicked => {
                                root.lang = "en";
                                root.language_changed("en");
                            }
                        }
                    }
                }
            }


            // ----------------------------------------------------------------
            // Theme
            // ----------------------------------------------------------------

            MaterialCard {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    SectionTitle {
                        text: I18n.appearance_title;
                        height: 28px;
                    }

                    Text {
                        text: I18n.appearance_hint;
                        color: MaterialTheme.text_secondary;
                        font-size: 13px;
                        wrap: word-wrap;
                        animate color { duration: 150ms; easing: ease-out; }
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        MaterialChoiceCard {
                            horizontal-stretch: 1;
                            title: I18n.theme_citrus_dark;
                            subtitle: I18n.theme_citrus_dark_desc;
                            show_preview: true;
                            preview: MaterialTheme.palette_preview_citrus_dark;
                            selected: root.theme_id == "citrus-dark";
                            clicked => {
                                root.theme_id = "citrus-dark";
                                root.theme_changed("citrus-dark");
                            }
                        }

                        MaterialChoiceCard {
                            horizontal-stretch: 1;
                            title: I18n.theme_citrus_light;
                            subtitle: I18n.theme_citrus_light_desc;
                            show_preview: true;
                            preview: MaterialTheme.palette_preview_citrus_light;
                            selected: root.theme_id == "citrus-light";
                            clicked => {
                                root.theme_id = "citrus-light";
                                root.theme_changed("citrus-light");
                            }
                        }

                        MaterialChoiceCard {
                            horizontal-stretch: 1;
                            title: I18n.theme_catppuccin_mocha;
                            subtitle: I18n.theme_catppuccin_mocha_desc;
                            show_preview: true;
                            preview: MaterialTheme.palette_preview_catppuccin_mocha;
                            selected: root.theme_id == "catppuccin-mocha";
                            clicked => {
                                root.theme_id = "catppuccin-mocha";
                                root.theme_changed("catppuccin-mocha");
                            }
                        }
                    }
                }
            }


            Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}

