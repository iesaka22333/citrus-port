// ============================================================================
// CitrusPort Material 3 Theme
// ============================================================================

export global MaterialTheme {
    // ------------------------------------------------------------------------
    // Primary
    // ------------------------------------------------------------------------
    in property <color> primary: #8a5100;
    in property <color> on_primary: #ffffff;
    in property <color> primary_container: #ffddb0;
    in property <color> on_primary_container: #2c1600;

    // ------------------------------------------------------------------------
    // Background & Surface
    // ------------------------------------------------------------------------
    in property <color> background: #fff8f4;
    in property <color> on_background: #211a14;
    in property <color> surface: #fff8f4;
    in property <color> on_surface: #211a14;
    in property <color> surface_container_lowest: #ffffff;
    in property <color> surface_container_low: #fdf1e8;
    in property <color> surface_container: #f8ece3;
    in property <color> surface_container_high: #f2e6dd;
    in property <color> surface_container_highest: #ece0d7;

    // ------------------------------------------------------------------------
    // Outline & Error
    // ------------------------------------------------------------------------
    in property <color> outline: #81766c;
    in property <color> outline_variant: #d4c3b6;
    in property <color> error: #ba1a1a;
    in property <color> on_error: #ffffff;
    in property <color> error_container: #ffdad6;
    in property <color> on_error_container: #410002;

    // ------------------------------------------------------------------------
    // Typography
    // ------------------------------------------------------------------------
    in property <color> text_primary: #211a14;
    in property <color> text_secondary: #625a52;
    in property <color> text_disabled: #938a82;
    in property <color> text_on_primary: #ffffff;
    in property <color> text_on_primary_container: #2c1600;

    // ------------------------------------------------------------------------
    // Control
    // ------------------------------------------------------------------------
    in property <color> control_background: #fffaf7;
    in property <color> control_background_hover: #f8eee6;
    in property <color> control_background_pressed: #f0e2d7;
    in property <color> control_border: #81766c;
    in property <color> control_border_focus: #8a5100;
}